# Copy this file to .env and change what you need. .env is never committed

# The local database from docker-compose.yml
DATABASE_URL=postgres://rustyparty:rustyparty@127.0.0.1:5432/rustyparty

# The port the server listens on. Default 3000
# PORT=3000

# How much the server logs. Default backend=debug,tower_http=debug
# RUST_LOG=backend=info